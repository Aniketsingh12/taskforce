# Copy to .env.local for local overrides (Vite loads .env.local automatically
# and it's gitignored). Not needed for local dev or Docker Compose — only set
# this for a production deploy where the frontend and backend are on different
# domains (e.g. frontend on Vercel, backend on Railway/Render).

# Origin of the deployed backend, NO trailing slash and NO /api suffix
# (the client appends /api itself). Baked in at BUILD time — set it in your
# hosting platform's project settings, not just locally.
VITE_API_URL=https://your-backend.up.railway.app
