# ─── TaskForce environment ───────────────────────────────────────────────
# Copy to .env and fill in what you use. Everything has a default; with NO keys
# set, the platform runs on the built-in `mock` model so you can demo it offline.

# App
ENVIRONMENT=development
# Comma-separated, no trailing slashes. In production this must be your
# deployed frontend's exact origin (e.g. https://your-app.vercel.app) — the
# backend rejects browser requests from any origin not listed here.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Persistence (SQLite file; ":memory:" keeps everything in RAM).
# In production, point this at a MOUNTED VOLUME path (e.g. /data/taskforce.db
# on a Railway volume) — without one, every redeploy wipes the database, since
# the container filesystem is otherwise ephemeral.
DB_PATH=taskforce.db

# Scheduler (fires scheduled/cron workflows)
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30

# ─── Local open-source models (free) ───
# Point at your Ollama server. Pull a model first, e.g. `ollama pull llama3.1:8b`.
# The Models page lists what's actually installed by querying this server.
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# ─── Together AI (open-source models via API — get a key at api.together.ai) ───
# Cheap hosted access to Llama / DeepSeek / Qwen / Kimi etc. When this key is
# set, the Models page lists Together's LIVE catalog (queried from their API),
# so pick the best current model from there rather than trusting the default
# below — their lineup changes faster than any hardcoded list.
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1
TOGETHER_DEFAULT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ─── Hosted gateway (recommended for hosted models) ───
# One key unlocks Claude, GPT, Gemini, Groq-served Llama, etc.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-haiku

# ─── Direct providers (optional — only if not going through OpenRouter) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ─── Fallback (used when a primary provider fails) ───
# Defaults to the offline `mock` model so demos never break.
# Per-agent overrides live on the agent itself (fallback_model: "provider:model").
FALLBACK_PROVIDER=mock
FALLBACK_MODEL=mock-default

# ─── Webhook security ───
# Leave empty for local use (webhooks are then unauthenticated). Set a value
# before exposing the API — callers must send it as the X-Webhook-Secret header.
WEBHOOK_SECRET=

# ─── Public-demo access control ─────────────────────────────────────────────
# Leave ADMIN_TOKEN empty locally: gating is then fully disabled and the app
# behaves exactly as it always has. SET IT IN PRODUCTION — without it, anyone
# with your URL can run billed models and DELETE your workflows.
#
# With it set:
#   • visitors  → browse + run workflows, forced onto DEMO_PROVIDER (free)
#   • admin     → real models + create/edit/delete, via the X-Admin-Token header
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=
# What anonymous runs are forced onto. The mock provider streams realistic
# role-aware output and simulates tool calls, so the demo still shows the whole
# platform at zero cost.
DEMO_PROVIDER=mock
DEMO_MODEL=mock-default

# ─── Spend circuit breaker ───
# Hard ceiling on total run cost per UTC day, across every trigger source
# (manual, scheduled, webhook). New billed runs are refused once it's reached;
# free demo runs are unaffected. Empty = no limit.
# This is the ONLY setting that bounds your maximum bill — a rate limit caps
# how fast one client goes, not how much everyone spends in total.
DAILY_COST_LIMIT_USD=1.0

# ─── Rate limiting (per client IP, run-triggering endpoints only) ───
# In-memory and per-process: resets on redeploy and doesn't span replicas.
# It's a speed bump against hammering, not the thing protecting your budget.
RATE_LIMIT_RUNS=20
RATE_LIMIT_WINDOW_SECONDS=3600

# ─── Supabase / Postgres (full version — MVP uses SQLite) ───
# SUPABASE_URL=
# SUPABASE_KEY=
# DATABASE_URL=

# ─── Redis (background runs in the full version) ───
# REDIS_URL=redis://localhost:6379/0
